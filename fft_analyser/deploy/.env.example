# Copy to .env and fill in. Never commit the filled-in file.
#
#   cp fft_analyser/deploy/.env.example .env
#   chmod 600 .env
#
# .env is already covered by .gitignore.

# API host. Primary is api.x2wireless.com; the secondary and the legacy
# path form are the fallbacks if your tenant still serves them.
X2_BASE_URL=https://api.x2wireless.com
# X2_BASE_URL=https://api.tritoncloud.se
# X2_BASE_URL=https://login.x2wireless.com/TritonCloud/webapp_mobile/api

X2_USERNAME=
X2_PASSWORD=
X2_SITE_ID=

# Up to five sensor addresses to load at startup, comma separated.
# Leave blank to pick them in the UI after connecting.
# Run `python -m fft_analyser.preflight` to list the addresses at your site.
X2_MONITORS=

# How often the live feed checks for a newly uploaded waveform, in seconds.
# There is no point polling faster than the sensors upload: match this to
# the devices' config_mlt_auto_interval. 300 (5 min) is a sane default.
X2_POLL_SECONDS=300
