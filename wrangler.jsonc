{
  // Deploys the browser build of the FFT analyser, plus a read-only API
  // middleman to the X2 Cloud.
  //
  //   npx wrangler deploy
  //
  // "name" must match the Worker you already deployed, or you get a second
  // one at a different URL.
  //
  // Secrets (never put these in this file - it is committed):
  //   npx wrangler secret put ACCESS_TOKEN
  //   npx wrangler secret put X2_USERNAME
  //   npx wrangler secret put X2_PASSWORD
  //
  // Without ACCESS_TOKEN the /api/* routes refuse to serve anything, so the
  // static page still works but live data stays off.
  //
  // The Dash app (fft_analyser/app.py) is a Python server and cannot run
  // here - see fft_analyser/README.md for how to host that.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "endaq-python-fft",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    // Not secret, so it lives here. Anything listed in "vars" is REWRITTEN
    // on every deploy, which is why X2_SITE_ID is deliberately absent: set
    // it in the Cloudflare dashboard (Settings -> Variables) and a deploy
    // will leave it alone. Add it here instead only if you would rather
    // keep it in version control.
    "X2_BASE_URL": "https://api.x2wireless.com"
  },
  "observability": {
    "enabled": true
  }
}
